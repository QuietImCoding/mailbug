# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real secrets.

# --- IMAP ingestion (set both to enable IMAP; otherwise fixtures are used) ---
MAILBUG_IMAP_HOST=imap.example.com
MAILBUG_IMAP_USER=you@example.com
MAILBUG_IMAP_PASS=
# Defaults: port 993, secure (TLS). Set port for non-default, set secure to "false" for plain.
MAILBUG_IMAP_PORT=993
MAILBUG_IMAP_SECURE=true

# --- LLM classification ---
DEEPSEEK_API_KEY=