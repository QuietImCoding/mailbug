# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — never commit real secrets.

# --- IMAP ingestion (set both to enable IMAP; otherwise fixtures are used) ---
MAILBUG_IMAP_HOST=imap.example.com
MAILBUG_IMAP_USER=you@example.com
MAILBUG_IMAP_PASS=
# Defaults: port 993, secure (TLS). Set port for non-default, set secure to "false" for plain.
MAILBUG_IMAP_PORT=993
MAILBUG_IMAP_SECURE=true

# --- LLM classification ---
# Required to enable LLM classification (otherwise a deterministic mock is used).
DEEPSEEK_API_KEY=
# Optional overrides. If unset, baseURL/model come from src/config/mail-spec.json.
# Point at your Polytoken (or any OpenAI-compatible) endpoint:
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# Max output tokens. Reasoning models spend tokens thinking first, so give
# enough headroom above the size of the JSON answer (default from mail-spec.json is 512).
DEEPSEEK_MAX_TOKENS=2048

# --- HTTP ---
PORT=3000
# Max JSON request body size accepted by the body parser (default 10mb).
BODY_LIMIT=10mb

# --- Actions ---
# Bark device key for the "page-user" action (e.g. https://api.day.app/<key>/<message>).
MAILBUG_BARK_KEY=